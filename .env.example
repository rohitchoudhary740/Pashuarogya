# Copy to .env (kept out of git). Read by pashuraksha/backend/main.py at startup.

# पशु मित्र voice assistant brain — Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-key-here
# optional: pin a model (default tries gemini-2.5-flash, then 2.0-flash, then 1.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# optional overrides
# PASHU_AI_DIR=C:\path\to\breed-ai-service      (Pashu Lens sidecar folder)
# PASHU_TUNNEL_DOMAIN=your-reserved.ngrok-free.dev
# PASHU_DB_URL=postgresql://user:pass@host/db
